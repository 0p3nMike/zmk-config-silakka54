/*
 * Silakka54 — plain starting keymap.
 *
 * Deliberately conventional: standard QWERTY, real modifier keys, no
 * mod-taps or home-row mods. This is a base to customise FROM in ZMK
 * Studio, not a finished layout.
 *
 * Physical position indices (matches silakka54-layouts.dtsi order):
 *   0-11 number row, 12-23 top row, 24-35 home row, 36-47 bottom row,
 *   48-50 left thumbs (outer->inner), 51-53 right thumbs (inner->outer).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJUST 3


/ {
    combos {
        compatible = "zmk,combos";
        /* Esc + Backspace together = unlock ZMK Studio. Both are on the
         * number row outer corners, so this needs both halves connected.
         * The Adjust-layer &studio_unlock below is the one-half fallback. */
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };
        /* LEFT-HALF-ONLY unlock: Esc + Tab + Q (positions 0, 12, 13).
         * All three are on the left half, so this works when the right
         * half is absent or unpaired. */
        combo_studio_unlock_left {
            timeout-ms = <75>;
            key-positions = <0 12 13>;
            bindings = <&studio_unlock>;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4    &kp N5        &kp N6 &kp N7    &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R     &kp T         &kp Y  &kp U     &kp I     &kp O   &kp P    &kp BSLH
&kp LCTRL &kp A  &kp S  &kp D    &kp F     &kp G         &kp H  &kp J     &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V     &kp B         &kp N  &kp M     &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LGUI &mo LOWER &kp SPACE     &kp RET &mo RAISE &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE &kp F1    &kp F2   &kp F3   &kp F4    &kp F5       &kp F6    &kp F7   &kp F8   &kp F9    &kp F10  &kp DEL
&trans    &kp EXCL  &kp AT   &kp HASH &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp LPAR  &kp RPAR &kp PIPE
&trans    &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &trans       &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &kp HOME &kp END
&trans    &kp UNDER &kp PLUS &kp LBRC &kp RBRC  &trans       &kp PG_UP &kp PG_DN &trans  &trans    &kp F11  &kp F12
                             &trans   &trans    &trans       &trans    &trans   &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE &kp N1   &kp N2   &kp N3   &kp N4   &kp N5      &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp DEL
&trans    &trans   &trans   &trans   &trans   &trans      &trans   &trans   &trans   &trans   &trans   &trans
&trans    &trans   &trans   &trans   &trans   &trans      &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_MUTE &trans
&trans    &trans   &trans   &trans   &trans   &trans      &kp C_PP &trans   &trans   &trans   &trans   &trans
                            &trans   &trans   &trans      &trans   &trans   &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &trans     &trans &trans &trans &trans &trans &sys_reset
&out OUT_TOG &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &bootloader
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans                     &trans &trans &trans
            >;
        };
    };
};
